{
  "name": "track-props-studio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Photos / video / 360° / Google Street View -> 3D race tracks and props, with an in-browser three.js editor.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "server": "node scripts/run-server.mjs",
    "start": "node scripts/start.mjs",
