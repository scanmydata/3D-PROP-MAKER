    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@mkkellogg/gaussian-splats-3d": "0.4.7",
    "fflate": "0.8.3",
    "leaflet": "1.9.4",
    "marked": "18.2.0",
    "meshoptimizer": "1.3.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=20"
  }
